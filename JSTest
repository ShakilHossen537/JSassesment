let nftCollection = [];

function mintNFT(SrNo, name, Height, Subject, address, passoutYear) {
    const nft = {
        SrNo: SrNo,
        name: name,
        Height: Height, 
        Subject: Subject,
        address: address,
        passoutYear: passoutYear
    };
    nftCollection.push(nft);
}

function listNFTs() {
    nftCollection.forEach((nft, index) => {
        console.log(`#NFT ${index + 1}:`);
        console.log(`SrNo: ${nft.SrNo}`);
        console.log(`Name: ${nft.name}`);
        console.log(`Height: ${nft.Height}`);
        console.log(`Subject: ${nft.Subject}`);
        console.log(`Address: ${nft.address}`);
        console.log(`Passout Year: ${nft.passoutYear}`);
        console.log('---------------------');
    });
}

function getTotalSupply() {
    return nftCollection.length;
}

